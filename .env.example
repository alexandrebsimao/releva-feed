APP_NAME="Releva Feed"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=releva_feed
DB_USERNAME=releva
DB_PASSWORD=releva

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=180

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="hello@releva.test"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

VITE_APP_NAME="${APP_NAME}"

AI_PROVIDER=groq
GROQ_API_KEY=
AI_CLASSIFIER_MODEL=openai/gpt-oss-20b
AI_SUMMARIZER_MODEL=openai/gpt-oss-120b
AI_REQUEST_INTERVAL_MS=5000
ARTICLE_RETENTION_DAYS=15
