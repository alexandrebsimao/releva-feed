APP_NAME="Releva Feed"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://releva.innapses.com
APP_HOST=releva.innapses.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=releva_feed_production
DB_USERNAME=releva
DB_PASSWORD=change-this-database-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
QUEUE_CONNECTION=database
CACHE_STORE=database
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=180

MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@innapses.com
MAIL_FROM_NAME="Releva Feed"
RESEND_API_KEY=

AI_PROVIDER=groq
GROQ_API_KEY=
AI_CLASSIFIER_MODEL=openai/gpt-oss-20b
AI_SUMMARIZER_MODEL=openai/gpt-oss-120b
AI_REQUEST_INTERVAL_MS=5000
ARTICLE_RETENTION_DAYS=15
