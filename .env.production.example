APP_NAME="Releva Feed"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://releva.innapses.com
APP_HOST=releva.innapses.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=releva_feed_production
DB_USERNAME=releva
DB_PASSWORD=change-this-database-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
QUEUE_CONNECTION=database
CACHE_STORE=database
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=180

MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@innapses.com
MAIL_FROM_NAME="Releva Feed"
RESEND_API_KEY=

AI_PROVIDER=groq
GROQ_API_KEY=
AI_CLASSIFIER_MODEL=openai/gpt-oss-20b
AI_SUMMARIZER_MODEL=openai/gpt-oss-120b
AI_REQUEST_INTERVAL_MS=5000
AI_TRANSIENT_RETRIES=3
AI_ARTICLE_DESCRIPTION_MAX_CHARS=6000
AI_CLUSTER_ARTICLE_LIMIT=6
AI_CLUSTER_ARTICLE_MAX_CHARS=3000
AI_MAX_TOPICS=3
AI_MIN_TOPIC_CONFIDENCE=0.65
AI_MAX_EXISTING_TOPICS=100
AI_CLASSIFIER_MAX_TOKENS=500
AI_CLASSIFIER_TEMPERATURE=0.1
AI_SUMMARIZER_MAX_TOKENS=600
AI_SUMMARIZER_TEMPERATURE=0.1
ARTICLE_RETENTION_DAYS=15
