{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "releva/feed",
    "type": "project",
    "description": "Curadoria pessoal de notícias com Laravel.",
    "keywords": [
        "laravel",
        "news",
        "rss",
        "curation"
    ],
    "license": "MIT",
    "require": {
        "php": "8.3.*",
        "ext-bcmath": "*",
        "ext-intl": "*",
        "ext-pcntl": "*",
        "ext-pdo_pgsql": "*",
        "ext-zip": "*",
        "laravel/ai": "^0.11",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.0",
        "resend/resend-laravel": "^1.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names=http,queue,vite"
        ],
        "post-autoload-dump": [
            "@php -r \"@mkdir('storage/framework/views', 0775, true); @mkdir('storage/framework/cache/data', 0775, true); @mkdir('storage/framework/sessions', 0775, true); @mkdir('bootstrap/cache', 0775, true); @mkdir('vendor/bin', 0775, true); file_put_contents('vendor/bin/heroku-php-nginx', '#!/usr/bin/env sh' . PHP_EOL . 'mkdir -p /app/.heroku/php/var/run/nginx /tmp/client_body_temp /tmp/fastcgi_temp' . PHP_EOL . 'exec heroku-php-nginx \\\"\\$@\\\"' . PHP_EOL); chmod('vendor/bin/heroku-php-nginx', 0755);\"",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
