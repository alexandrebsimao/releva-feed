APP_NAME="Releva Feed"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seu-dominio.com

# Trava a porta do container no Dokploy para coincidir com a regra do Traefik
PORT=5000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# No Dokploy, direcione os logs para stderr para visualização direta na aba Logs do container
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Configuração do PostgreSQL no Dokploy
# Pode usar DATABASE_URL fornecida pelo serviço Postgres do Dokploy ou as variáveis individuais:
# DATABASE_URL=postgresql://usuario:senha@dokploy-postgres:5432/nome_banco
DB_CONNECTION=pgsql
DB_HOST=dokploy-postgres
DB_PORT=5432
DB_DATABASE=releva_feed_production
DB_USERNAME=releva
DB_PASSWORD=sua-senha-segura

# Sessão, Filas e Cache no PostgreSQL (sem dependência externa)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
QUEUE_CONNECTION=database
CACHE_STORE=database
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=180

# Envio de emails (Resend)
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noticias@seu-dominio-verificado.com
MAIL_FROM_NAME="Releva Feed"
RESEND_API_KEY=

# IA (Groq)
AI_PROVIDER=groq
GROQ_API_KEY=
AI_CLASSIFIER_MODEL=openai/gpt-oss-20b
AI_SUMMARIZER_MODEL=openai/gpt-oss-120b
AI_REQUEST_INTERVAL_MS=5000
AI_TRANSIENT_RETRIES=3
AI_ARTICLE_DESCRIPTION_MAX_CHARS=6000
AI_CLUSTER_ARTICLE_LIMIT=6
AI_CLUSTER_ARTICLE_MAX_CHARS=3000
AI_MAX_TOPICS=3
AI_MIN_TOPIC_CONFIDENCE=0.65
AI_MAX_EXISTING_TOPICS=100
AI_CLASSIFIER_MAX_TOKENS=500
AI_CLASSIFIER_TEMPERATURE=0.1
AI_SUMMARIZER_MAX_TOKENS=600
# Frequência da Coleta Automática de Feeds (everySixHours, everyThreeHours, everyTwoHours, hourly, everyThirtyMinutes, everyFifteenMinutes)
FEEDS_SCHEDULE_FREQUENCY=everySixHours

ARTICLE_RETENTION_DAYS=15

# Permite instalar devDependencies para compilar Vite/Tailwind no buildpack
NPM_CONFIG_PRODUCTION=false
